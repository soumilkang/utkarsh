public class Solution {

    public static int minEatingSpeed(int[] piles, int h) {
        int low = 1, mid, high, k = 0, max = piles[0], hours = 0;

        for (int i = 1; i < piles.length; i++) {
            if (piles[i] > max) {
                max = piles[i];
            }
        }

        high = max;

        while (low <= high) {
            mid = (low + high) / 2;

            for (int i = 0; i < piles.length; i++) {
                hours += Math.ceil(piles[i] / (double) mid);
            }

            if (hours <= h) {
                k = mid;
                high = mid - 1;
            } else if (hours < h) {
                high = mid - 1;
            } else if (hours > h) {
                low = mid + 1;
            }

            hours = 0;
        }
        return k;
    }

   
}
